{
  "name": "zy-image-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for the zy-api GPT Image gateway",
  "type": "module",
  "bin": {
    "zy-image-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=build/sea.cjs",
    "binary": "npm run bundle && node scripts/build-binary.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke:live": "node scripts/live-mcp-smoke.mjs",
    "smoke:quality": "node scripts/live-quality-smoke.mjs",
    "smoke:binary": "node scripts/smoke-stdio.mjs",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "probe": "node scripts/probe-capabilities.mjs",
    "start": "node dist/index.js",
    "verify": "npm test && npm run check && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "undici": "^8.10.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
